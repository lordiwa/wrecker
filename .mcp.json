{
  "mcpServers": {
    "wrecker": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/mcp-server.cjs"
      ],
      "env": {
        "WARGAME_HOME": "${CLAUDE_PLUGIN_ROOT}",
        "WARGAME_PROVIDER": "claude-cli",
        "WARGAME_OUT_DIR": "${CLAUDE_PLUGIN_DATA}/out"
      }
    }
  }
}
